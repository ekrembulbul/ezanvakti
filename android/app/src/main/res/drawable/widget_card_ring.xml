<?xml version="1.0" encoding="utf-8"?>
<!-- Küçük widget'taki kerahat kartının yaklaşırken görünen kenarlığı (1,5 dp,
     kartı büyütmeden içe çizilir). Beyaz çizilir; renk WidgetRenderer'da
     renk filtresiyle verilir. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <stroke
        android:width="1.5dp"
        android:color="#FFFFFFFF" />
    <corners android:radius="12dp" />
</shape>
