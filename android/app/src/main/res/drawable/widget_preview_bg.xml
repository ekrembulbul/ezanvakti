<?xml version="1.0" encoding="utf-8"?>
<!-- Widget seçicideki önizleme ve ilk çizim için yer tutucu zemin (koyu sabah
     paleti). Gerçek zemin WidgetRenderer'ın çizdiği radyal gradyan bitmap'tir;
     çizildiğinde bunun yerine geçer. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:centerColor="#FF143049"
        android:endColor="#FF08141F"
        android:startColor="#FF2C5279"
        android:type="linear" />
    <corners android:radius="16dp" />
</shape>
