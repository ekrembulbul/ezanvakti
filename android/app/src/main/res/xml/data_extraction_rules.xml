<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ bulut yedeği ve cihazdan cihaza aktarım. Konumlar, ayarlar,
     alarm tanımları ve kayıtlar (SQLite) taşınır. Yerel alarm durumu taşınmaz:
     işletim sistemindeki alarmlar taşınmadığı için geri yüklenen kayıtlar
     "kurulu" sanılır ve uzlaştırma alarmı kurmaz. Widget ve bildirim listeleri
     uygulama açılınca yeniden üretilir. Özel ezan sesleri 25 MB yedek kotasını
     aşabilir; dosyası olmayan alarm varsayılan alarm sesiyle çalar.
     backup_rules.xml (Android 11 ve öncesi) ile aynı tutulmalı. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ezanvakti_alarms.xml" />
        <exclude domain="sharedpref" path="ezanvakti_missions_v2.xml" />
        <exclude domain="sharedpref" path="ezanvakti_alarm_journal_v1.xml" />
        <exclude domain="sharedpref" path="ezanvakti_quiet.xml" />
        <exclude domain="sharedpref" path="ezanvakti_widget_alignment.xml" />
        <exclude domain="sharedpref" path="HomeWidgetPreferences.xml" />
        <exclude domain="sharedpref" path="scheduled_notifications.xml" />
        <exclude domain="file" path="alarm_sounds/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ezanvakti_alarms.xml" />
        <exclude domain="sharedpref" path="ezanvakti_missions_v2.xml" />
        <exclude domain="sharedpref" path="ezanvakti_alarm_journal_v1.xml" />
        <exclude domain="sharedpref" path="ezanvakti_quiet.xml" />
        <exclude domain="sharedpref" path="ezanvakti_widget_alignment.xml" />
        <exclude domain="sharedpref" path="HomeWidgetPreferences.xml" />
        <exclude domain="sharedpref" path="scheduled_notifications.xml" />
        <exclude domain="file" path="alarm_sounds/" />
    </device-transfer>
</data-extraction-rules>
