<?xml version="1.0" encoding="utf-8"?>
<!-- Renkler burada değil, AlarmRingActivity içinde paletten atanır: zemin
     gradyanı, vurgu ve metin renkleri kullanıcının tema tercihine ve alarmın
     çalacağı vaktin dilimine göre değişiyor.

     Yerleşim iOS'un kilit ekranı çalar ekranını izler: bilgi üstte (etiket,
     büyük saat, uygulama adı), eylemler altta (erteleme düğmesi ve kaydırarak
     kapatma). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/alarm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="112dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/alarm_icon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_alarm_bell"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/alarm_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/alarm_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="76sp"
            android:letterSpacing="-0.03"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/alarm_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/alarm_default_label"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/alarm_snooze"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="14dp"
            android:gravity="center"
            android:text="@string/alarm_snooze"
            android:textSize="17sp"
            android:clickable="true"
            android:focusable="true" />

        <com.ekrembulbul.ezanvakti.SlideToStopView
            android:id="@+id/alarm_dismiss"
            android:layout_width="match_parent"
            android:layout_height="60dp" />
    </LinearLayout>
</FrameLayout>
