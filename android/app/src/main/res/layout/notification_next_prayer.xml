<?xml version="1.0" encoding="utf-8"?>
<!-- Sabit "sıradaki vakit" satırı, kapalı hal (DecoratedCustomViewStyle gövdesi,
     en çok 48 dp). Tek satır: [vakit etiketi 12, kalın] 8 dp [vakit saati 16]
     esnek boşluk [geri sayım 22, sağa yaslı]. Kerahat penceresinde (Android 12+,
     kapalı halde başlık çizilmediği için) vakit satırının altında kerahat çipi:
     kelime + sayaç, orta widget'taki çiple aynı. Metin renkleri sistem bildirim
     stillerinden; vakit etiketi kodda palet vurgusuna boyanır. Yazı boyutları
     kodda yazı ölçeğine göre sınırlanır (48 dp'ye sığsın).

     Saat hiç kesilmez: geri sayım ağırlıksız olduğu için önce tam genişliğiyle
     ölçülür, kalan alan sol sütuna (0dp + ağırlık) kalır. Etiket + saat grubu
     o sütunda wrap_content (AT_MOST) ölçülür: sığmazsa açık yalnız ağırlıklı
     etiketten düşülür (etiket kısalır, "…" alır), sığarsa grup büyümez ve saat
     etiketin hemen yanında kalır. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/next_prayer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:letterSpacing="0.07"
                android:maxLines="1"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/next_prayer_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
                android:textSize="16sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/next_prayer_chip"
            android:layout_width="wrap_content"
            android:layout_height="18dp"
            android:layout_marginTop="3dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/next_prayer_chip_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/notification_next_prayer_pill" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="9dp"
                android:paddingEnd="9dp">

                <TextView
                    android:id="@+id/next_prayer_chip_word"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <Chronometer
                    android:id="@+id/next_prayer_chip_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:countDown="true"
                    android:fontFeatureSettings="tnum"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <Chronometer
        android:id="@+id/next_prayer_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:countDown="true"
        android:fontFamily="sans-serif"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textSize="22sp" />
</LinearLayout>
